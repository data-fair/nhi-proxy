{
  "name": "@data-fair/nhi-proxy",
  "version": "0.2.0",
  "description": "Local NHI credential provider for agentic coding tools against a data-fair platform",
  "type": "module",
  "bin": {
    "nhi-proxy": "./dist/bin/nhi-proxy.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "check-types": "tsc",
    "test": "NODE_ENV=test node --test --test-force-exit 'src/**/*.test.ts'",
    "test-package": "node --test --test-force-exit 'test-e2e/package.test.ts'",
    "test-e2e": "node --test --test-force-exit 'test-e2e/**/*.test.ts'",
    "e2e": "bash test-e2e/run.sh",
    "e2e-stack": "docker compose up -d --wait",
    "e2e-stack-down": "docker compose down -v",
    "quality": "npm run lint && npm run check-types && npm run test && npm run test-package",
    "prepack": "npm run build",
    "prepare": "husky || true"
  },
  "author": "Alban Mouton <alban.mouton@gmail.com>",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.11",
    "eslint": "^9.32.0",
    "husky": "^9.1.7",
    "mongodb": "^7.6.0",
    "neostandard": "^0.12.0",
    "typescript": "^5.8.3",
    "undici": "^7.0.0"
  }
}
